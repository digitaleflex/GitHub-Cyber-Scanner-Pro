# Token GitHub (requis pour l'API GitHub)
# Generer un token sur https://github.com/settings/tokens
# Permissions necessaires : public_repo
GITHUB_TOKENS=ghp_votre_token

# Repo pour les issues (optionnel)
GITHUB_REPO=votre_user/votre_repo

# Base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scanner_db
DB_USER=postgres
DB_PASSWORD=votre_password

# Collecteur RSS dedie (Miniflux) - remplace le fetch maison pour la veille
# Active le pont Miniflux -> cyber_news
MINIFLUX_ENABLED=true
# URL de l'API Miniflux (compose: http://miniflux:8080 , local docker: http://localhost:8080)
MINIFLUX_URL=http://miniflux:8080
# Token API Miniflux (genere dans Parametres > API Key de l'interface Miniflux)
MINIFLUX_TOKEN=
# Identifiants de l'admin Miniflux (cree au 1er demarrage via compose)
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=changeme
MINIFLUX_DB_PASSWORD=minifluxpass
