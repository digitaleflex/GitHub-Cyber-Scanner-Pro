# Token GitHub (requis pour l'API GitHub)
# Generer un token sur https://github.com/settings/tokens
# Permissions necessaires : public_repo
# Plusieurs tokens peuvent etre fournis (separer par des virgules) pour la rotation
GITHUB_TOKEN=ghp_votre_token
GH_TOKENS=

# Repo pour les issues (optionnel)
GITHUB_REPO=votre_user/votre_repo

# Base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scanner_db
DB_USER=postgres
DB_PASSWORD=votre_password

# Neo4j Social Graph
# Si le conteneur Neo4j est lance avec NEO4J_AUTH=none, mettre NEO4J_AUTH_NONE=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cybergraph
NEO4J_AUTH_NONE=true

# Intervalle de scan en secondes (86400 = quotidien)
SCAN_INTERVAL_SECONDS=86400

# Collecteur RSS dedie (Miniflux) - remplace le fetch maison pour la veille
# Active le pont Miniflux -> cyber_news
MINIFLUX_ENABLED=true
# URL de l'API Miniflux (compose: http://miniflux:8080 , local docker: http://localhost:8080)
MINIFLUX_URL=http://miniflux:8080
# Token API Miniflux (genere dans Parametres > API Key de l'interface Miniflux)
MINIFLUX_TOKEN=
# Identifiants de l'admin Miniflux (cree au 1er demarrage via compose)
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=changeme
MINIFLUX_DB_PASSWORD=minifluxpass

# Premium Threat Intel APIs (optionnel - tous gratuits en tier de base)
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# SecurityTrails: https://securitytrails.com/app/account/credentials
SECURITYTRAILS_API_KEY=
# Shodan: https://account.shodan.io/
SHODAN_API_KEY=
# GreyNoise: https://viz.greynoise.io/account/
GREYNOISE_API_KEY=
